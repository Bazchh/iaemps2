# Copie para .env e preencha. O .env nunca entra no repositório.
# Nenhuma chave é obrigatória na fundação: o adaptador falso roda tudo.

# Chave do serviço de linguagem ativo. Só aqui, nunca no config.toml.
IAEMPS2_CHAVE_SERVICO=

# Caminho do config.toml, se não estiver na pasta atual.
IAEMPS2_CONFIG=
